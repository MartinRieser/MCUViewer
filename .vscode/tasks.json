{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "Run application with gdbserver",
            "command": "Start-Process -FilePath ./launch/launch.bat"
        },
        {
            "type": "shell",
            "label": "Build MCUViewer (UCRT64)",
            "command": "C:\\msys64\\msys2_shell.cmd",
            "args": [
                "-ucrt64",
                "-defterm",
                "-no-start",
                "-here",
                "-c",
                "mkdir -p build && cd build && cmake .. && ninja"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Rebuild MCUViewer (UCRT64)",
            "command": "C:\\msys64\\msys2_shell.cmd",
            "args": [
                "-ucrt64",
                "-defterm",
                "-no-start",
                "-here",
                "-c",
                "rm -rf build && mkdir build && cd build && cmake .. && ninja"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Run MCUViewer",
            "command": "${workspaceFolder}\\build\\MCUViewer.exe",
            "options": {
                "cwd": "${workspaceFolder}\\build"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Build MCUViewer (macOS)",
            "command": "mkdir -p build && cd build && cmake .. && make -j8",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Rebuild MCUViewer (macOS)",
            "command": "rm -rf build && mkdir build && cd build && cmake .. && make -j8",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Run MCUViewer (macOS)",
            "command": "${workspaceFolder}/build/MCUViewer",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}